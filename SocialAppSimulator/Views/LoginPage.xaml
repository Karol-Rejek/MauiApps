<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SocialAppSimulator.Views.LoginPage"
             Title="LoginPage">
    <ScrollView>
        <Grid RowDefinitions="100,60,60,60"
            Padding="10" RowSpacing="10">
            <StackLayout Grid.Row="0">
                <Label Text="Login" HorizontalOptions="Center" VerticalOptions="CenterAndExpand"/>
            </StackLayout>
            <Grid Grid.Row="1" ColumnDefinitions="*, 3*">
                <Label Text="Email:" Padding="10"
                       Grid.Column="0" HorizontalOptions="Center" VerticalOptions="Center"/>
                <Entry Text="{Binding Email}" 
                       Grid.Column="1" Margin="5" />
            </Grid>
            <Grid Grid.Row="2" ColumnDefinitions="*, 3*">
                <Label Text="Password:" Padding="10"
            Grid.Column="0" HorizontalOptions="Center" VerticalOptions="Center"/>
                <Entry Text="{Binding Password}" IsPassword="True" 
            Grid.Column="1" Margin="5" />
            </Grid>
            <Button Grid.Row="3" Text="Login" Command="{Binding LoginCommand}"/>
        </Grid>
    </ScrollView>
</ContentPage>