<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SocialAppSimulator.MainPage"
             xmlns:viewmodel="clr-namespace:SocialAppSimulator.src.VievModels"
             x:DataType="viewmodel:MainViewModel">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            <Image
                Source="dotnet_bot.png"
                HeightRequest="185"
                Aspect="AspectFit"
                SemanticProperties.Description="dot net bot in a submarine number ten" />

            <Label Text="Welcome in This App" 
                   TextColor="Crimson" FontSize="Large" TextTransform="Uppercase" 
                   VerticalOptions="Center" HorizontalOptions="Center"/>
            <Button Text="Login" Command="{Binding GoToLoginPageCommand}"/>
            <Button Text="Register" Command="{Binding GoToRegisterPageCommand}"/>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
